{
  "_说明": "复制本文件为 data/llm.json 并填入你的凭据即可启用任务级模型/接口覆盖。llm.json 已在 .gitignore 中，不会被提交。删除某个任务键即回退到 claude CLI 默认登录态。任务键：write=AI写作, rewrite=AI改稿(缺省回退write), score=RSS评分, dist=多平台转换(缺省回退write), growth=AI复盘(缺省回退write)。provider 支持 claude / openai / command。",
  "write": {
    "provider": "openai",
    "model": "填写你要使用的 OpenAI 模型",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY"
  },
  "score": {
    "provider": "openai",
    "model": "填写一个便宜快速的模型",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY"
  },
  "rewrite": {
    "provider": "openai",
    "model": "填写你要使用的改稿模型",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY"
  },
  "dist": {
    "provider": "openai",
    "model": "填写你要使用的 OpenAI 模型",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY"
  },
  "growth": {
    "provider": "openai",
    "model": "填写你要使用的 OpenAI 模型",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY"
  }
}
