{
  "_说明": "复制本文件为 data/llm.json 并填入你的凭据即可启用任务级模型/接口覆盖。llm.json 已在 .gitignore 中，不会被提交。删除某个任务键即回退到 claude CLI 默认登录态。任务键：write=AI写作, score=RSS评分, dist=多平台转换(缺省回退write), growth=AI复盘(缺省回退write)",
  "write": {
    "model": "glm-5.1",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "你的网关密钥",
      "ANTHROPIC_BASE_URL": "https://open.bigmodel.cn/api/anthropic"
    }
  },
  "score": {
    "model": "glm-5-turbo",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "你的网关密钥",
      "ANTHROPIC_BASE_URL": "https://open.bigmodel.cn/api/anthropic"
    }
  }
}
